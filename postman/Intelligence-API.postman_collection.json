    {
      "name": "04 - INC-002 - Provider B Unavailable",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Unavailable provider returns HTTP 503\", function () {\n    pm.response.to.have.status(503);\n});\n\nconst body = pm.response.json();\n\npm.test(\"Response identifies unavailable provider\", function () {\n    pm.expect(body.detail).to.eql(\n        \"Data provider provider_b is temporarily unavailable\"\n    );\n});\n\npm.test(\"Response includes Request ID\", function () {\n    const requestId = pm.response.headers.get(\"X-Request-ID\");\n\n    pm.expect(requestId).to.be.a(\"string\").and.not.empty;\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "demo-key-123"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/organizations?domain=vistula.example",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
