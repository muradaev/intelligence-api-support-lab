  "item": [
    {
      "name": "01 - Organization Search - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Valid key returns 200\", function () {\n    pm.response.to.have.status(200);\n});\n\nconst body = pm.response.json();\n\npm.test(\"Organization count is correct\", function () {\n    pm.expect(body.count).to.eql(1);\n});\n\npm.test(\"Organization domain is correct\", function () {\n    pm.expect(body.results[0].domain).to.eql(\"caspian.example\")\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "demo-key-123"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/organizations?domain=caspian.example",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "8000",
          "path": [
            "api",
            "v1",
            "organizations"
          ],
          "query": [
            {
              "key": "domain",
              "value": "caspian.example"
            }
          ]
        }
      },
      "response": []
    },
