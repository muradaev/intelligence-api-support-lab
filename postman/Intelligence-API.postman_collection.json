    {
      "name": "05 - INC-003 - Provider C Rate Limited",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Provider C returns HTTP 429\", function () {\n    pm.response.to.have.status(429);\n});\n\nconst body = pm.response.json();\n\npm.test(\"Rate limit error message is correct\", function () {\n    pm.expect(body.detail).to.eql(\n        \"Provider C rate limit exceeded\"\n    );\n});\n\npm.test(\"Retry-After header is 5 seconds\", function () {\n    const retryAfter = pm.response.headers.get(\"Retry-After\");\n    pm.expect(retryAfter).to.eql(\"5\");\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "demo-key-123"
